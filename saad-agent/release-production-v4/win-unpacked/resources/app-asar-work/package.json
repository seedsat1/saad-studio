{
  "name": "saad-agent",
  "version": "6.5.0",
  "description": "Autonomous AI Engineering Studio Desktop Platform",
  "main": "dist/desktop/main.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc && node -e \"import('fs').then(fs => fs.copyFileSync('src/desktop/preload.cjs', 'dist/desktop/preload.cjs'))\"",
    "build:ui": "cd ui && npm run build",
    "build:all": "npm run build && npm run build:ui",
    "desktop": "tsc && electron .",
    "dist": "electron-builder --win",
    "dist:nsis": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "bin": {
    "saad-agent": "./dist/index.js"
  },
  "keywords": [
    "ai",
    "agent",
    "engineering",
    "saad-studio"
  ],
  "author": "Saad Studio Team",
  "license": "ISC",
  "type": "module",
  "build": {
    "appId": "com.saadstudio.agent",
    "productName": "Saad Agent",
    "copyright": "Copyright © 2026 Saad Studio",
    "icon": "resources/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "ui/dist/**",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Saad Agent",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "Saad Agent-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.0.1",
    "chalk": "^5.6.2",
    "diff": "^9.0.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.0.0",
    "inquirer": "^14.0.2",
    "openai": "^6.45.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
