/**
 * storyEngine.js — EditPilot AI (Saad Studio)
 *
 * Handles the Story Engine feature:
 *   - Sends transcript to POST /api/panel/generate/story
 *   - Parses the structured response
 *   - Renders result cards in the DOM
 *
 * Credit deduction happens server-side (spendCredits in route.ts).
 * This module never touches credits directly.
 */

import { getSiteUrl } from './storage.js';

const STORY_ENDPOINT = '/api/panel/generate/story';

// ─────────────────────────────────────────────────────────────
// API CALL
// ─────────────────────────────────────────────────────────────

/**
 * Send transcript to the Story Engine API.
 * @param {string} token  - ssp_... panel token
 * @param {string} transcript
 * @returns {Promise<{sections: StorySection[], creditsUsed: number, generationId: string|null}>}
 */
export async function analyzeTranscript(token, transcript, options = {}) {
  console.log('[analyzeTranscript] A1 — entered, transcript len:', transcript?.length);

  // DEV MODE: Return mock data immediately
  if (token === 'ssp_dev_token_12345') {
    console.log('[analyzeTranscript] DEV MODE — returning mock data');
    await new Promise(resolve => setTimeout(resolve, 1500)); // Simulate delay

    return {
      sections: [
        {
          title: 'Hook - Strong Opening',
          start: '00:00:00',
          end: '00:00:15',
          reason: 'Compelling hook that grabs attention immediately',
          label: 'Intro',
          editorNote: 'Great energy - keep this!'
        },
        {
          title: 'Problem Statement',
          start: '00:00:15',
          end: '00:01:30',
          reason: 'Clear articulation of the viewer\'s pain point',
          label: 'Setup',
          editorNote: 'Sets up the narrative perfectly'
        },
        {
          title: 'Solution Overview',
          start: '00:01:30',
          end: '00:03:00',
          reason: 'Introduces the main solution with visual examples',
          label: 'Content',
          editorNote: 'Key value proposition - essential section'
        },
        {
          title: 'Demo & Implementation',
          start: '00:03:00',
          end: '00:05:30',
          reason: 'Step-by-step walkthrough showing practical application',
          label: 'Tutorial',
          editorNote: 'Most engaging part - great pacing'
        },
        {
          title: 'Results & Proof',
          start: '00:05:30',
          end: '00:06:45',
          reason: 'Shows concrete results and social proof',
          label: 'Evidence',
          editorNote: 'Builds credibility effectively'
        },
        {
          title: 'Call to Action',
          start: '00:06:45',
          end: '00:07:30',
          reason: 'Clear CTA with next steps for viewers',
          label: 'CTA',
          editorNote: 'Strong close - good retention to the end'
        }
      ],
      creditsUsed: 5,
      generationId: 'mock_generation_dev'
    };
  }

  const base = getSiteUrl().replace(/\/+$/, '');
  console.log('[analyzeTranscript] A2 — base URL:', base);

  // Build request payload with story settings
  const payload = {
    transcript,
    type: 'story_cut',
    runtime: options.runtime || 5,
    platform: options.platform || 'youtube',
    videoType: options.videoType || 'tutorial',
    tone: options.tone || 'educational',
    model: options.model || 'claude-sonnet-4.6',  // AI model selection
  };

  // Add optional fields
  if (options.goal && options.goal.trim()) {
    payload.goal = options.goal.trim();
  }
  if (options.structure && options.structure.trim()) {
    payload.structure = options.structure.trim();
  }
  if (options.hook && options.hook.trim()) {
    payload.hook = options.hook.trim();
  }
  if (options.cta && options.cta.trim()) {
    payload.cta = options.cta.trim();
  }
  if (options.fileName) {
    payload.fileName = options.fileName;
  }
  if (options.sequenceName) {
    payload.sequenceName = options.sequenceName;
  }

  console.log('[analyzeTranscript] A3 — BEFORE fetch, payload:', payload);
  let res;
  try {
    res = await fetch(`${base}${STORY_ENDPOINT}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`,
      },
      body: JSON.stringify(payload),
    });
    console.log('[analyzeTranscript] A4 — AFTER fetch, status:', res.status, 'ok:', res.ok);
  } catch (e) {
    console.error('[analyzeTranscript] FETCH ERROR:', e?.stack || e?.message || e);
    throw e;
  }

  console.log('[analyzeTranscript] STEP 7 — parsing JSON');
  let data;
  try {
    data = await res.json();
    console.log('[analyzeTranscript] STEP 8 — JSON parsed:', data);
  } catch (e) {
    console.error('[analyzeTranscript] JSON PARSE ERROR:', e?.stack || e?.message || e);
    data = {};
  }

  console.log('[analyzeTranscript] STEP 9 — before processing');
  try {
    console.log('[analyzeTranscript]   DATA TYPE:', typeof data);
    console.log('[analyzeTranscript]   DATA KEYS:', Object.keys(data || {}));
    console.log('[analyzeTranscript]   sections is array?', Array.isArray(data?.sections));
    console.log('[analyzeTranscript]   sections length:', data?.sections?.length);
  } catch (e) {
    console.error('[analyzeTranscript] PROCESS ERROR:', e?.stack || e?.message || e);
  }

  if (!res.ok) {
    console.log('[analyzeTranscript] A6 — non-OK response, throwing. error:', data?.error);
    const err = new Error(data?.error || `Server error ${res.status}`);
    err.statusCode       = res.status;
    err.isCreditsError   = res.status === 402;
    err.requiredCredits  = data?.requiredCredits;
    err.currentBalance   = data?.currentBalance;
    throw err;
  }

  console.log('[analyzeTranscript] A7 — returning data');
  return data;
}

// ─────────────────────────────────────────────────────────────
// RENDERING
// ─────────────────────────────────────────────────────────────

/**
 * Render story section cards into the results container.
 * @param {Array<{title:string, start:string, end:string, reason:string}>} sections
 * @param {HTMLElement} container
 * @param {(section: object) => void}             onSelect   - called when a card is clicked
 * @param {(section: object, btn: HTMLElement) => void} onApply   - called when "Apply" button is clicked
 */
export function renderStorySections(sections, container, onSelect, onApply) {
  container.innerHTML = '';

  if (!sections?.length) {
    container.innerHTML = '<div class="story-empty">No sections returned.</div>';
    return;
  }

  sections.forEach((section, idx) => {
    const card = document.createElement('div');
    card.className = 'story-card';
    card.setAttribute('data-idx', idx);

    const hasTime = section.start !== '00:00:00' || section.end !== '00:00:00';
    const timeBadge = hasTime
      ? `<div class="sc-time">${esc(section.start)} <span>→</span> ${esc(section.end)}</div>`
      : '';

    // Section Label badge (Intro, Main Content, CTA, etc.)
    const labelBadge = section.label
      ? `<span class="sc-label">${esc(section.label)}</span>`
      : '';

    // Editor Note - why this soundbite was selected
    const editorNote = section.editorNote
      ? `<div class="sc-editor-note">
          <span class="sc-note-icon">💡</span>
          <span class="sc-note-text">${esc(section.editorNote)}</span>
        </div>`
      : '';

    card.innerHTML = `
      <div class="sc-header">
        <span class="sc-num">${idx + 1}</span>
        ${labelBadge}
        <span class="sc-title">${esc(section.title)}</span>
        ${timeBadge}
        <button class="sc-apply-btn" title="Apply marker to Premiere timeline">&#9654;</button>
      </div>
      <div class="sc-reason">${esc(section.reason)}</div>
      ${editorNote}
    `;

    // Card click → select (but not when clicking the apply button)
    card.addEventListener('click', (e) => {
      if (e.target.closest('.sc-apply-btn')) return;
      container.querySelectorAll('.story-card').forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      onSelect?.(section);
    });

    // Apply button click
    const applyBtn = card.querySelector('.sc-apply-btn');
    applyBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      onApply?.(section, applyBtn);
    });

    container.appendChild(card);
  });
}

// ─────────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────────

function esc(s) {
  return String(s || '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
}
