<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest
  Version="6.0"
  ExtensionBundleId="app.saadstudio.cep"
  ExtensionBundleVersion="1.0.0"
  ExtensionBundleName="Saad Studio"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>
  <ExtensionList>
    <Extension Id="app.saadstudio.cep.main" Version="1.0.0" />
    <Extension Id="app.saadstudio.cep.draw" Version="1.0.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[15.0,99.9]" />
      <Host Name="AEFT" Version="[17.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="app.saadstudio.cep.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/dist/index.html</MainPath>
          <ScriptPath>./jsx/index.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Saad Studio</Menu>
          <Geometry>
            <Size>
              <Width>600</Width>
              <Height>650</Height>
            </Size>
            <MinSize>
              <Width>380</Width>
              <Height>500</Height>
            </MinSize>
            <MaxSize>
              <Width>1200</Width>
              <Height>1600</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/logo.png</Icon>
            <Icon Type="DarkNormal">./icons/logo.png</Icon>
            <Icon Type="RollOver">./icons/logo.png</Icon>
            <Icon Type="DarkRollOver">./icons/logo.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>

    <Extension Id="app.saadstudio.cep.draw">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/dist/draw.html</MainPath>
          <ScriptPath>./jsx/index.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Saad Studio — Draw to Edit</Menu>
          <Geometry>
            <Size>
              <Width>720</Width>
              <Height>760</Height>
            </Size>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/logo.png</Icon>
            <Icon Type="DarkNormal">./icons/logo.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
