// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL  → Primary PostgreSQL runtime connection
  // DIRECT_URL    → Direct PostgreSQL connection for prisma migrate / db push
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── EXISTING MODELS ────────────────────────────────────────────────────────

model UserApiLimit {
  id        String   @id @default(cuid())
  userId    String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSubscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  stripeCustomerId       String?   @unique @map(name: "stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map(name: "stripe_subscription_id")
  stripePriceId          String?   @map(name: "stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map(name: "stripe_current_period_end")
  planId                 String?   // "starter" | "plus" | "pro" | "max"
  billingInterval        String?   @default("monthly") // "monthly" | "annual"
}

// ─── ADMIN MODELS ────────────────────────────────────────────────────────────

/// Platform user record synced from Clerk — stores admin-managed data.
model User {
  id                 String        @id @default(cuid())
  name               String?
  email              String        @unique
  phone              String?
  creditBalance      Int           @default(0)
  monthlyCredits     Int           @default(0)
  creditsExpireAt    DateTime?
  lastCreditRenewal  DateTime?
  creditAdvanceBalance Int         @default(0)
  creditAdvanceRequestedAt DateTime?
  creditAdvanceCycleEnd DateTime?
  role               String        @default("USER")
  isBanned           Boolean       @default(false)
  createdAt          DateTime      @default(now())

  profiles      UserProfile[]
  generations   Generation[]
  transactions  AdminTransaction[]
  characters    UserCharacter[]
  elements      UserElement[]
  locations     UserLocation[]
  effects       UserEffect[]
  cameras       UserCamera[]
  palettes      UserPalette[]
  providerUsageRecords ProviderUsageRecord[]
  apiIdempotencies     ApiIdempotency[]
  creditLedgerEntries  CreditLedgerEntry[]
  voiceAgents          VoiceAgent[]
  voiceAgentTasks      VoiceAgentTask[]
  voiceAgentContacts   VoiceAgentContact[]
  voiceAgentIntegrations VoiceAgentIntegrationConnection[]
  voiceAgentUsage      VoiceAgentUsage[]
  voiceAgentAuditLogs  VoiceAgentAuditLog[]
}

/// Records every AI generation for security monitoring and cost tracking.
model Generation {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt           String
  mediaUrl         String?
  outputUrl        String?
  type             String?
  status           String?
  assetType        String
  modelUsed        String
  cost             Float    @default(0)
  isFlagged        Boolean  @default(false)
  isFavorite       Boolean  @default(false)
  createdAt        DateTime @default(now())

  // Provider tracking fields
  providerCostUsd  Float?
  providerTokens   Int?
  providerCredits  Float?
  providerName     String?
  providerModel    String?
  providerRequestId String?
  resolution       String?
  duration         Float?
  aspectRatio      String?
  quality          String?
  posterUrl        String?
  posterStatus     String   @default("pending")
  posterGeneratedAt DateTime?
  posterError      String?
  providerCostSource String? // 'actual' | 'estimated' | 'unknown'
  profileId        String?
  profile          UserProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, profileId])
  @@index([createdAt])
  @@index([isFavorite])
  @@index([posterStatus])
  providerUsageRecords ProviderUsageRecord[]
  generationRequestSnapshot GenerationRequestSnapshot?
  apiIdempotencies ApiIdempotency[]
  creditLedgerEntries CreditLedgerEntry[]
}

/// Profiles created under a single user account for separating generation workspaces while sharing credits and login.
model UserProfile {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  avatarPhoto  String?
  avatarPreset Int          @default(1)
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  generations  Generation[]

  @@index([userId])
  @@index([userId, isDefault])
}

model ProviderUsageRecord {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId      String?
  generation        Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  providerName      String?
  providerModel     String?
  providerRequestId String?
  providerCostUsd   Float?
  providerTokens    Int?
  providerCredits   Float?
  providerCostSource String? // 'actual' | 'estimated' | 'unknown'
  duration          Float?
  resolution        String?
  quality           String?
  aspectRatio       String?
  status            String?
  rawPayloadSafe    String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([generationId])
  @@index([providerRequestId])
  @@index([createdAt])
  creditLedgerEntries CreditLedgerEntry[]
}

model ApiIdempotency {
  id                       String      @id @default(cuid())
  userId                   String
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  route                    String
  operationType            String      @default("generation")
  key                      String
  requestHash              String
  status                   String      @default("processing")
  generationId             String?
  generation               Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  responseStatus           Int?
  responseJson             Json?
  errorCode                String?
  errorMessage             String?     @db.Text
  attemptCount             Int         @default(0)
  processingLeaseExpiresAt DateTime?
  lastHeartbeatAt          DateTime?
  providerDispatchedAt     DateTime?
  completedAt              DateTime?
  failedAt                 DateTime?
  expiresAt                DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@unique([userId, route, operationType, key])
  @@index([userId, createdAt])
  @@index([status])
  @@index([processingLeaseExpiresAt])
  @@index([expiresAt])
  @@index([generationId])
}

model CreditLedgerEntry {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationId          String?
  generation            Generation?          @relation(fields: [generationId], references: [id], onDelete: SetNull)
  projectId             String?
  jobId                 String?
  idempotencyKey        String?
  providerUsageRecordId String?
  providerUsageRecord   ProviderUsageRecord? @relation(fields: [providerUsageRecordId], references: [id], onDelete: SetNull)
  quoteSnapshotId       String?
  originalEntryId       String?
  originalEntry         CreditLedgerEntry?   @relation("CreditLedgerReversal", fields: [originalEntryId], references: [id], onDelete: SetNull)
  reversalEntries       CreditLedgerEntry[]  @relation("CreditLedgerReversal")
  delta                 Int
  reason                String
  operationType         String
  status                String              @default("settled")
  metadata              Json?
  createdAt             DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([generationId])
  @@index([projectId])
  @@index([jobId])
  @@index([idempotencyKey])
  @@index([providerUsageRecordId])
  @@index([quoteSnapshotId])
  @@index([originalEntryId])
}

model GenerationRequestSnapshot {
  id                        String      @id @default(cuid())
  generationId              String      @unique
  generation                Generation  @relation(fields: [generationId], references: [id], onDelete: Cascade)
  userId                    String
  provider                  String?
  model                     String?
  generationType            String?
  duration                  Float?
  resolution                String?
  aspectRatio               String?
  quality                   String?
  mode                      String?
  inputType                 String?
  userCreditsCharged        Float?
  estimatedProviderCostUsd  Float?
  requestPayload            Json?
  createdAt                 DateTime    @default(now())

  @@index([generationId])
}


/// Financial transactions: subscriptions and credit purchases.
model AdminTransaction {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           String
  amount         Float
  credits        Int
  paymentStatus  String    @default("PENDING")
  operatorUserId String?
  operatorEmail  String?
  decisionAt     DateTime?
  decisionReason String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([paymentStatus])
}

/// Visual CMS settings — single-row config table for site-wide UI content.
model SiteSetting {
  id               String  @id @default(cuid())
  siteName         String  @default("Saad Studio")
  logoUrl          String?
  primaryColor     String  @default("#7c3aed")
  topBannerAdText  String?
  isBannerActive   Boolean @default(false)
  adsEnabled       Boolean @default(false)
  termsOfServiceText String?
  privacyPolicyText  String?
}

// ─── VISUAL CMS — DYNAMIC CONTENT MODELS ─────────────────────────────────────

/// Stores editable content blocks keyed by page slug + section name.
/// Allows the admin to update text and media on any page without code changes.
model PageContent {
  id           String   @id @default(cuid())
  /// e.g. 'home', 'pricing', 'about', 'features'
  slug         String
  /// e.g. 'hero', 'features', 'cta', 'testimonials'
  sectionName  String
  textContent  String?
  mediaUrl     String?
  /// true = mediaUrl points to a video; false = image
  isVideo      Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@unique([slug, sectionName])
  @@index([slug])
}

/// Visual drag-and-drop page builder layout.
/// Stores the complete ordered block tree as JSON for 'home' and 'discover' pages.
model PageLayout {
  id           String   @id @default(cuid())
  /// Unique page identifier: 'home' | 'discover'
  pageName     String   @unique
  /// JSON array of ordered layout blocks with id, type, title, subtitle, mediaUrl, isVideo
  layoutBlocks Json     @default("[]")
  updatedAt    DateTime @updatedAt
}

/// Dynamic ad campaigns rendered site-wide based on type and active status.
model AdCampaign {
  id             String        @id @default(cuid())
  title          String
  headline       String?
  description    String?
  /// 'TOP_BANNER' | 'POPUP' | 'SIDEBAR' | 'CUSTOM'
  type           String        @default("CUSTOM")
  mediaUrl       String?
  mediaType      String?       @default("image")
  /// Pure CTA destination URL (e.g. '/pricing' or 'https://...')
  targetLink     String?
  ctaLabel       String?       @default("Explore Now")
  ctaTarget      String?       @default("_self")
  isActive       Boolean       @default(true)
  priority       Int           @default(10)
  audience       String        @default("ALL")
  animation      String        @default("fade")
  dismissible    Boolean       @default(true)
  dismissalModel String        @default("session")
  startDate      DateTime?
  expiresAt      DateTime?
  placements     AdPlacement[]
  events         AdEvent[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([priority])
}

/// Normalized per-page responsive placement geometries
model AdPlacement {
  id            String     @id @default(cuid())
  campaignId    String
  campaign      AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  route         String     // e.g. '/dashboard', '/video', 'ALL'
  placementMode String     @default("FLOATING") // 'FLOW' | 'FLOATING'
  anchor        String     @default("center")
  desktopX      Float      @default(50)
  desktopY      Float      @default(50)
  desktopW      Float      @default(40)
  desktopH      Float?
  tabletX       Float?
  tabletY       Float?
  tabletW       Float?
  tabletH       Float?
  mobileX       Float?
  mobileY       Float?
  mobileW       Float?
  mobileH       Float?
  slotId        String?
  zIndex        Int        @default(50)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([campaignId, route])
  @@index([route])
  @@index([campaignId])
}

/// Durable, concurrency-safe telemetry events for genuine impressions, clicks, dismissals
model AdEvent {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  eventType  String     // 'impression' | 'click' | 'dismissal'
  route      String
  createdAt  DateTime   @default(now())

  @@index([campaignId, eventType])
  @@index([createdAt])
}

/// Public cinematic showcase feed rendered on /explore.
/// Backed by admin CMS uploads and optimized for featured/trending feeds.
model ShowcaseItem {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  model        String
  provider     String
  videoUrl     String   @map("video_url")
  thumbnailUrl String   @map("thumbnail_url")
  prompt       String   @default("")
  tags         String[] @default([])
  featured     Boolean  @default(false)
  status       String   @default("draft")
  views        Int      @default(0)
  likes        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  type         String   @default("video")
  aspectRatio  String   @default("16:9") @map("aspect_ratio")

  @@index([featured, createdAt])
  @@index([status, createdAt])
  @@index([views, likes])
  @@index([createdAt])
  @@map("showcase_items")
}

// ——————————————————————————————————————————————————————————
// CINEMA STUDIO — PRODUCTION MODELS
// ——————————————————————————————————————————————————————————

model CinemaProject {
  id                String          @id @default(cuid())
  userId            String
  name              String          @default("Untitled Cinema Project")
  conceptPrompt     String          @default("")
  negativePrompt    String          @default("")
  toneGenre         String          @default("cinematic")
  modelRoute        String          @default("kwaivgi/kling-v3.0-pro/text-to-video")
  aspectRatio       String          @default("16:9")
  defaultDuration   Int             @default(5)
  creditBalanceSnap Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  shots             CinemaShot[]
  characters        CinemaCharacter[]
  locations         CinemaLocation[]
  assets            CinemaAsset[]
  jobs              CinemaJob[]

  @@index([userId, updatedAt])
}

model CinemaShot {
  id               String        @id @default(cuid())
  projectId        String
  orderIndex       Int           @default(0)
  title            String        @default("New Shot")
  prompt           String        @default("")
  negativePrompt   String        @default("")
  duration         Int           @default(5)
  ratio            String        @default("16:9")
  characterIds     String[]      @default([])
  locationId       String?
  cameraPreset     String        @default("static")
  cameraSpeed      Int           @default(50)
  motionIntensity  Int           @default(50)
  smoothness       Int           @default(50)
  lighting         String        @default("neutral")
  lens             String        @default("35mm")
  colorGrade       String        @default("cinematic")
  audioPrompt      String        @default("")
  seed             Int?
  consistencyLock  Boolean       @default(true)
  generationStatus String        @default("idle")
  outputAssetId    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  project          CinemaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, orderIndex])
}

model CinemaCharacter {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  description String        @default("")
  referenceUrl String?
  attributes  Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     CinemaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, name])
}

model CinemaLocation {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  description String        @default("")
  referenceUrl String?
  attributes  Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     CinemaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, name])
}

model CinemaAsset {
  id          String        @id @default(cuid())
  projectId   String
  shotId      String?
  type        String
  url         String
  thumbnailUrl String?
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now())

  project     CinemaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model CinemaJob {
  id          String        @id @default(cuid())
  projectId   String
  shotId      String
  userId      String
  status      String        @default("queued")
  taskId      String?
  modelRoute  String
  creditsCost Int           @default(0)
  error       String?
  resultUrl   String?
  payload     Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     CinemaProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([shotId, createdAt])
  @@index([userId, createdAt])
}

// ——————————————————————————————————————————————————————————
// TRANSITIONS STUDIO — PRODUCTION MODELS
// ——————————————————————————————————————————————————————————

model TransitionProject {
  id              String   @id @default(cuid())
  userId          String
  title           String   @default("Untitled Transition")
  inputAUrl       String?
  inputAType      String   @default("image")
  inputBUrl       String?
  inputBType      String   @default("image")
  presetId        String?
  aspectRatio     String   @default("16:9")
  duration        Int      @default(5)
  intensity       Int      @default(50)
  smoothness      Int      @default(50)
  cinematicStr    Int      @default(60)
  preserveFraming Boolean  @default(true)
  subjectFocus    Boolean  @default(true)
  resolution      String   @default("1080p")
  fps             Int      @default(24)
  enhance         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jobs            TransitionJob[]
  outputs         TransitionOutput[]

  @@index([userId, updatedAt])
}

model TransitionJob {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  presetId    String
  status      String   @default("queued")
  taskId      String?
  creditsCost Int      @default(0)
  error       String?
  resultUrl   String?
  payload     Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     TransitionProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  output      TransitionOutput?

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

model TransitionOutput {
  id           String   @id @default(cuid())
  projectId    String
  jobId        String   @unique
  userId       String
  url          String
  thumbnailUrl String?
  presetId     String
  presetName   String
  aspectRatio  String
  duration     Int
  inputAUrl    String?
  inputBUrl    String?
  reuseAsA     Boolean  @default(false)
  reuseAsB     Boolean  @default(false)
  createdAt    DateTime @default(now())

  project      TransitionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job          TransitionJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

// ——————————————————————————————————————————————————————————
// VARIATIONS STUDIO — PRODUCTION MODELS
// ——————————————————————————————————————————————————————————

model VariationProject {
  id                   String             @id @default(cuid())
  userId               String
  title                String             @default("Untitled Variation")
  referenceAssetUrl    String?
  referenceAssetId     String?
  selectedMode         String             @default("storyboard")
  selectedGenMode      String             @default("standard")
  outputCount          Int                @default(9)
  aspectRatio          String             @default("16:9")
  direction            String             @default("")
  negativeDirection    String             @default("")
  consistencyLock      Boolean            @default(true)
  settingsJson         Json               @default("{}")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  outputs              VariationOutput[]
  jobs                 VariationJob[]

  @@index([userId, updatedAt])
}

model VariationJob {
  id          String           @id @default(cuid())
  projectId   String
  userId      String
  status      String           @default("queued")
  error       String?
  payload     Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project     VariationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outputs     VariationOutput[]

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

model VariationOutput {
  id               String           @id @default(cuid())
  projectId        String
  jobId            String?
  userId           String
  variationMode    String
  presetId         String
  presetLabel      String
  modelUsed        String
  fallbackUsed     Boolean          @default(false)
  assetUrl         String?
  thumbnailUrl     String?
  generationStatus String           @default("pending")
  creditCost       Int              @default(0)
  kieTaskId        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project          VariationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job              VariationJob?    @relation(fields: [jobId], references: [id])

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([jobId])
}

// ——————————————————————————————————————————————————————————
// PRICING CONSTITUTION — ADMIN PRICING CONTROL
// ——————————————————————————————————————————————————————————

/// Single source of truth for all AI model credit costs.
/// Admin edits this via /admin/pricing and changes are live immediately.
model PricingConstitution {
  id              String   @id
  name            String
  notes           String   @default("")
  type            String   // "video" | "cinema" | "image" | "audio" | "3d"
  provider        String   // "kie" | "wavespeed"
  billing         String   // "per_sec" | "flat"
  kieCredits      Float    @default(0)
  waveUsd         Float    @default(0)
  userCreditsRate Float    @default(0)
  maxDuration     Int?
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

/// Key-value store for platform-wide config (e.g. kie_pkg_index).
model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ——————————————————————————————————————————————————————————
// TIMELINE STUDIO — PROJECT SAVE/LOAD
// ——————————————————————————————————————————————————————————

/// Stores a timeline project state server-side so the JSON is never
/// exposed to the client as a downloadable file.
model TimelineProject {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Untitled Project")
  /// Full timeline state JSON stored securely on server — never sent as a file download.
  stateJson Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// ——————————————————————————————————————————————————————————
// USER CHARACTERS — CHARACTER REFERENCE LIBRARY
// ——————————————————————————————————————————————————————————

/// Stores user-created character profiles with reference images.
model UserCharacter {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  description           String   @default("")
  referenceUrls         Json     @default("[]")
  coverUrl              String?
  provider              String   @default("reference")
  providerCharacterId   String?
  status                String   @default("ready")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, updatedAt])
}

model UserElement {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  description         String   @default("")
  referenceUrls       Json     @default("[]")
  coverUrl            String?
  provider            String   @default("reference")
  providerElementId   String?
  status              String   @default("ready")
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, updatedAt])
}

model UserLocation {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  description          String   @default("")
  referenceUrls        Json     @default("[]")
  coverUrl             String?
  provider             String   @default("reference")
  providerLocationId   String?
  status               String   @default("ready")
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId, updatedAt])
}

model UserEffect {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  description        String   @default("")
  referenceUrls      Json     @default("[]")
  coverUrl           String?
  provider           String   @default("reference")
  providerEffectId   String?
  status             String   @default("ready")
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, updatedAt])
}

model UserCamera {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  description        String   @default("")
  referenceUrls      Json     @default("[]")
  coverUrl           String?
  provider           String   @default("reference")
  providerCameraId   String?
  status             String   @default("ready")
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, updatedAt])
}

model UserPalette {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  colors      Json     @default("[]")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// Short-lived session for UXP plugin auto-login flow.
/// Created when plugin polls GET, approved when browser POSTs after sign-in.
model PanelAuthSession {
  id        String   @id                     // random hex session ID from plugin
  status    String   @default("pending")     // "pending" | "approved"
  token     String?                          // panel token set on approval
  expiresAt DateTime                         // TTL = createdAt + 5 min
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ——————————————————————————————————————————————————————————
// STUDIO IMG — ADMIN-CURATED PROMPT LIBRARY (browseable by subscribers)
// ——————————————————————————————————————————————————————————

/// Curated cards in the Studio Image library. Admin uploads, subscribers
/// browse and copy prompts. Each card has a cover (image and/or video)
/// plus an ordered sequence of retouching steps.
model StudioImg {
  id          String   @id @default(cuid())
  title       String
  prompt      String   @default("")
  params      String   @default("")
  model       String   @default("")
  category    String   @default("")

  // Cover media — image (before/after) and/or video with poster
  beforeUrl   String?
  afterUrl    String?
  videoUrl    String?
  posterUrl   String?
  mediaType   String   @default("image") // "image" | "video" | "both"

  steps       StudioImgStep[]

  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([model])
  @@index([isPublished, sortOrder])
}

/// Ordered retouching steps inside a StudioImg card. Each step has its own
/// optional before/after media and content (prompt for that step).
model StudioImgStep {
  id          String    @id @default(cuid())
  studioImgId String
  studioImg   StudioImg @relation(fields: [studioImgId], references: [id], onDelete: Cascade)

  label       String   @default("")
  content     String   @default("")
  beforeUrl   String?
  afterUrl    String?
  videoUrl    String?
  posterUrl   String?
  viewMode    String   @default("slider") // "slider" | "side"

  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studioImgId, sortOrder])
}

/// Admin-managed list of categories used in the Studio Image library.
model StudioImgCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/// Admin-managed list of AI models referenced by Studio Image cards.
model StudioImgModel {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ReapJob {
  id           String   @id @default(cuid())
  userId       String
  projectId    String   @unique // Reap's projectId
  tool         String   // captions, reframe, dubbing, transcription, edit-videos
  sourceUrl    String   // URL in R2
  status       String   @default("queued") // queued, prepped, processing, completed, failed
  error        String?
  outputUrls   Json     @default("[]") // final URLs stored in R2
  options      Json     @default("{}") // inputs/parameters
  creditsCost  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ReapWebhookLog {
  id          String   @id @default(cuid())
  projectId   String
  status      String
  payload     Json
  createdAt   DateTime @default(now())
}

/// Append-only diagnostic telemetry for mobile and client health auditing.
model MobileTelemetryEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  userId        String?
  route         String
  feature       String   // e.g. "image_upload", "video_start_frame", "voice_preview", "media_download"
  operation     String   // e.g. "upload", "playback", "download", "record", "generate_trigger"
  status        String   // "SUCCESS" | "FAILURE" | "DEGRADED"
  deviceClass   String   // "desktop" | "ios" | "android" | "other"
  browser       String?  // "safari" | "chrome" | "firefox" | "edge" | "other"
  os            String?  // "ios" | "android" | "macos" | "windows" | "other"
  errorCode     String?  // e.g. "SAFARI_MEDIA_ERROR", "UPLOAD_FAILED", "DOWNLOAD_FAILED", "MIC_PERMISSION_DENIED"
  httpStatus    Int?
  durationMs    Int?
  generationId  String?
  metadata      Json?    // Sanitized diagnostic payload (NO media bytes, tokens, or PII)

  @@index([createdAt])
  @@index([feature, deviceClass, createdAt])
  @@index([status, createdAt])
  @@index([userId])
}

// ——————————————————————————————————————————————————————————
// SAAD VOICE AGENT — DASHBOARD VOICE TASK ORCHESTRATION
// ——————————————————————————————————————————————————————————

model VoiceAgent {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String   @default("Saad Voice Agent")
  companyName        String   @default("Saad Studio")
  tone               String   @default("calm")
  language           String   @default("ar-IQ")
  dialect            String   @default("iraqi")
  introScript        String   @db.Text
  approvalPolicy     String   @default("always_ask")
  phoneNumber        String?
  recordingAllowed   Boolean  @default(false)
  isDefault          Boolean  @default(false)
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tasks              VoiceAgentTask[]

  @@index([userId, updatedAt])
}

model VoiceAgentTask {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId            String?
  agent              VoiceAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  goal               String   @db.Text
  language           String   @default("ar-IQ")
  dialect            String   @default("iraqi")
  status             String   @default("draft")
  resultChannel      String   @default("platform")
  approvalPolicy     String   @default("always_ask")
  estimatedCredits   Int      @default(0)
  actualCredits      Int?
  costBreakdown      Json     @default("{}")
  planJson           Json     @default("{}")
  timelineJson       Json     @default("[]")
  transcriptJson     Json     @default("[]")
  finalSummary       String?  @db.Text
  lastError          String?  @db.Text
  humanIntervention  Boolean  @default(false)
  rating             Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  steps              TaskStep[]
  calls              VoiceAgentCall[]
  toolExecutions     AgentToolExecution[]
  approvals          ApprovalRequest[]
  usage              VoiceAgentUsage[]
  auditLogs          VoiceAgentAuditLog[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model TaskStep {
  id          String   @id @default(cuid())
  taskId      String
  task        VoiceAgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  orderIndex  Int      @default(0)
  title       String
  toolId      String?
  status      String   @default("pending")
  riskLevel   String   @default("low")
  inputJson   Json     @default("{}")
  outputJson  Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId, orderIndex])
}

model VoiceAgentCall {
  id                 String   @id @default(cuid())
  taskId             String
  task               VoiceAgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId             String
  direction          String   @default("outbound")
  provider           String   @default("mock")
  providerCallId     String?
  fromNumber         String?
  toNumber           String?
  status             String   @default("queued")
  durationSec        Int?
  recordingUrl       String?
  recordingAllowed   Boolean  @default(false)
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transcripts        CallTranscript[]

  @@index([userId, createdAt])
  @@index([taskId, createdAt])
  @@index([providerCallId])
}

model CallTranscript {
  id          String   @id @default(cuid())
  callId      String
  call        VoiceAgentCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId      String
  speaker     String
  text        String   @db.Text
  offsetMs    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([callId, offsetMs])
  @@index([userId, createdAt])
}

model AgentToolExecution {
  id           String   @id @default(cuid())
  taskId       String
  task         VoiceAgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId       String
  toolId       String
  riskLevel    String   @default("low")
  status       String   @default("queued")
  inputJson    Json     @default("{}")
  outputJson   Json     @default("{}")
  approvalId   String?
  error         String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
  @@index([toolId])
}

model ApprovalRequest {
  id              String   @id @default(cuid())
  taskId          String
  task            VoiceAgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String
  actionType      String
  reason          String   @db.Text
  summary         String   @db.Text
  affectedData    Json     @default("{}")
  status          String   @default("pending")
  expiresAt       DateTime?
  decidedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([taskId, status])
  @@index([userId, createdAt])
}

model VoiceAgentContact {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  notes       String?  @db.Text
  preferences Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, name])
}

model VoiceAgentIntegrationConnection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  status      String   @default("mock")
  scopes      String[] @default([])
  settings    Json     @default("{}")
  encryptedSecretRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId, updatedAt])
}

model VoiceAgentUsage {
  id                 String   @id @default(cuid())
  taskId             String
  task               VoiceAgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  estimatedCredits   Int      @default(0)
  actualCredits      Int      @default(0)
  telephonyMinutes   Float    @default(0)
  sttCredits         Int      @default(0)
  ttsCredits         Int      @default(0)
  llmCredits         Int      @default(0)
  providerCostUsd    Float?
  providerCostSource String   @default("mock")
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
  @@index([taskId])
}

model VoiceAgentAuditLog {
  id        String   @id @default(cuid())
  taskId    String?
  task      VoiceAgentTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([taskId, createdAt])
  @@index([eventType])
}
