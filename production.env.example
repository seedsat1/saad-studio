# Saad Studio — production environment checklist. NAMES ONLY, NO VALUES.
#
# This file is committed on purpose and must never contain a real value. It is a
# checklist for standing up a new host: copy it, fill in the copy, keep the copy
# out of git.
#
#   cp production.env.example .env.production
#   chmod 600 .env.production && chown root:root .env.production
#
# It differs from .env.example: that one lists every variable the code can read,
# this one lists only what production actually needs, grouped by whether the
# site works without it. Derived from the 137 static `process.env.*` reads plus
# the 24 names read dynamically through the registries in
# lib/provider-registry.ts, lib/provider-router.ts and lib/ai-engine.ts — those
# last ones are invisible to a plain grep for "process.env".
#
# NEXT_PUBLIC_* is inlined into the client bundle at build time: changing one
# needs a rebuild, and it must also be passed as a Docker build arg. Never put a
# secret behind a NEXT_PUBLIC_ name.


# ═══ TIER 1 — REQUIRED. The site does not work without these. ═══════════════

# Database. Pooled connection for the app, direct connection for migrations.
# Verified by GET /api/health, which returns 503 when the database is unreachable.
DATABASE_URL=
DIRECT_URL=

# Authentication. The publishable key never appears in a `process.env` read in
# this repo — the Clerk SDK reads it itself — so a grep-based migration misses
# it and every page 500s. It is required.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# Scheduled jobs. All six /api/cron/* endpoints return 503 without this, so the
# reconciliation and cleanup jobs stop silently. Minimum 16 characters:
#   openssl rand -hex 32
# Not present in any local env file today — set it before the first deploy.
CRON_SECRET=

# Active object storage. isBackblazeConfigured() in lib/storage/provider-registry.ts
# requires the key id, the secret, and one of the two bucket names.
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=
B2_BUCKET_NAME=
B2_ENDPOINT=
B2_REGION=
B2_PUBLIC_URL=
B2_PUBLIC_BASE_URL=
NEXT_PUBLIC_B2_PUBLIC_URL=
NEXT_PUBLIC_B2_PUBLIC_BASE_URL=

# Public origin. lib/video-posters.ts builds absolute URLs from this before
# handing them to ffmpeg; a wrong value makes poster generation fetch the wrong
# host. No trailing slash.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
APP_URL=

# CORS. lib/security.ts falls back to the saadstudio.app pair plus localhost,
# which is wrong on any other hostname. Comma-separated.
ALLOWED_ORIGINS=

# Shared HMAC secret. Used directly, and also as the fallback for
# PANEL_TOKEN_SECRET (lib/panel-auth.ts), the Smart CLI OAuth signing key
# (lib/smart-cli-oauth.ts) and STORYBOARD_SAFETY_TOKEN_SECRET. Dropping it
# breaks the Premiere panel and the Smart CLI even though nothing is named
# "nextauth" in this app any more.
NEXTAUTH_SECRET=

# Admin access. Gates /influencers and the admin surfaces in middleware.ts.
ADMIN_USER_ID=
ADMIN_EMAILS=


# ═══ TIER 2 — REQUIRED FOR THE FEATURES YOU SELL ════════════════════════════
# Each model provider is independent: a missing key disables that provider's
# models and leaves the rest of the site working.

# Google (Veo family, Gemini Omni, Imagen, Nano Banana). Four accepted aliases;
# lib/provider-registry.ts also reads GOOGLE_GENERATIVE_AI_API_KEY, which no
# static `process.env` read mentions.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

OPENAI_API_KEY=
WAVESPEED_API_KEY=
KIE_API_KEY=
KIEAI_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
GROQ_API_KEY=

# BytePlus / Ark. Three accepted aliases for the key.
BYTEPLUS_API_KEY=
BYTEPLUS_ARK_API_KEY=
ARK_API_KEY=
BYTEPLUS_BASE_URL=
BYTEPLUS_ARK_BASE_URL=
BYTEPLUS_MODEL=
BYTEPLUS_MODEL_FAST=
BYTEPLUS_MODEL_MINI=

# Post-production (separate from the generation path).
REAP_API_KEY=
REAP_API_BASE=

# Scene Studio. RUNNINGHUB_WORKFLOW_ID is empty in the current .env.production,
# so this feature is already degraded in production — decide, do not just copy.
RUNNINGHUB_API_KEY=
RUNNINGHUB_WORKFLOW_ID=
RUNNINGHUB_TEXT_NODE_ID=
RUNNINGHUB_IMAGE_NODE_ID=

# Payments. Neither pair appears in any local env file, so their live values
# exist only in Vercel. Confirm which processor is actually live before cutover;
# a missing webhook secret means payments succeed and credits are never granted.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
ZAINCASH_MERCHANT_ID=
ZAINCASH_MSISDN=
ZAINCASH_SECRET=
ZAINCASH_CLIENT_ID=
ZAINCASH_CLIENT_SECRET=
ZAINCASH_API_BASE_URL=
ZAINCASH_PAY_BASE_URL=
ZAINCASH_IQD_PER_USD=

# Premiere / After Effects panel.
PANEL_TOKEN_SECRET=
PANEL_TOKEN_MAX_AGE_SECONDS=
CALLBACK_SECRET=

# Transactional email. RESEND_API_KEY is empty in the current .env.production,
# so email is already degraded in production.
RESEND_API_KEY=
RESEND_FROM=

# Inngest — NOT NEEDED TODAY, listed so the gap is explicit rather than hidden.
#
# The dependency is installed and /api/inngest is a public route, but
# app/api/inngest/route.ts registers exactly one function (`helloWorld`, which
# composes a greeting and sleeps 2s) and lib/inngest/client.ts builds the client
# with only `id` and `name`. There is no event key, nothing in the app sends an
# Inngest event, and no INNGEST_* name appears anywhere in app/, lib/ or
# components/ or in any local env file.
#
# Consequence today: GET and POST /api/inngest both return
# {"code":"internal_server_error"} with HTTP 500, verified in the container. No
# function executes, so this is dead weight rather than an exposure.
#
# These two are what the SDK reads by itself — like Clerk's publishable key, they
# never appear in a `process.env` read, so a grep-based migration would miss
# them. Fill them in only if you activate Inngest; leaving them empty keeps the
# current behaviour exactly.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# ═══ TIER 3 — OPTIONAL. Sensible defaults exist in code. ════════════════════

# Pricing overrides. lib/pricing.ts uses built-in constants when unset; setting
# these changes what customers are charged, so copy them deliberately.
SOURCE_CREDIT_USD=
CREDIT_MARGIN_PERCENT=
AUDIO_CREDIT_MARGIN_PERCENT=
WELCOME_SIGNUP_CREDITS=
SCENE_STUDIO_CREDITS=
CODE_CHAT_CREDITS=
ASSIST_CHAT_CREDITS=

# Feature flags and moderation.
NSFW_SCAN_ENABLED=
NSFW_SCAN_PROVIDER=
NSFW_SCAN_OPENAI_API_KEY=
NSFW_SCAN_OPENAI_MODEL=
NSFW_SCAN_INCLUDE_IMAGE_URLS=
GENERATION_PRECHECK_ENABLED=
GENERATION_PRECHECK_OPENAI_MODEL=
GENERATION_PRECHECK_OPENAI_BLOCKING=
STORYBOARD_NSFW_MODEL=
STORYBOARD_NSFW_SEXUAL_THRESHOLD=
STORYBOARD_VISION_NSFW_CHECK=
STORYBOARD_VISION_NSFW_MODEL=
STORYBOARD_SAFETY_TOKEN_SECRET=
PROMPT_EXTRACTOR_MODEL=
SAAD_WATERMARK_ENABLED=

# Per-task AI provider overrides. Read dynamically in lib/ai-engine.ts; default
# is "kie". AI_PROVIDER is the global default.
AI_PROVIDER=
STORY_ENGINE_PROVIDER=
SUBTITLE_TRANSLATE_PROVIDER=

# Storage routing. NOTE: the active write provider is NOT an env var — it lives
# in the platformConfig table under key "storage_runtime_config_v1" and defaults
# to backblaze. See the migration notes.
MEDIA_PROVIDER=
MEDIA_FALLBACK_PROVIDER=
MEDIA_DELIVERY_MODE=
BROWSER_CDN_BASE_URL=
NEXT_PUBLIC_BROWSER_CDN_BASE_URL=
BYTEPLUS_CDN_BASE_URL=
BYTEPLUS_MEDIA_CDN_BASE_URL=
BYTEPLUS_MEDIA_URL_MODE=
BYTEPLUS_IMAGE_PREPROCESS_MODE=

# Annual unlimited plan tuning. Read dynamically in lib/annual-image-unlimited.ts.
ANNUAL_UNLIMITED_IMAGE_DAILY_LIMIT=
ANNUAL_UNLIMITED_IMAGE_FAST_DAILY_LIMIT=
ANNUAL_UNLIMITED_IMAGE_SLOWDOWN_MS=

# Idempotency tuning.
IDEMPOTENCY_PROCESSING_LEASE_MS=
IDEMPOTENCY_HEARTBEAT_MS=
IDEMPOTENCY_FINAL_RETENTION_MS=

# KIE catalogue overrides and the admin-only resync token.
KIE_SYNC_CRON_TOKEN=
KIE_VIDEO_MODEL_OVERRIDES_JSON=
KIE_VIDEO_ROUTE_OVERRIDES_JSON=
KIE_IMAGE_MODEL_OVERRIDES_JSON=

# Support widget.
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=

# Cloudflare R2 bucket CORS admin route only (app/api/admin/r2-cors).
CF_API_TOKEN=
CLOUDFLARE_API_TOKEN=


# ═══ TIER 4 — SELF-HOSTING ONLY. Not set on Vercel. ═════════════════════════

# Pinned to /usr/bin/ffmpeg by the Dockerfile. lib/server/ffmpeg-path.ts probes
# PATH when unset, so this is an optimisation, not a requirement.
FFMPEG_PATH=
# Public base URL of the bucket holding the installers. When set,
# next.config.mjs redirects /downloads/* there instead of serving ~1 GB of
# public/ from the application host.
STATIC_CDN_BASE_URL=


# ═══ DO NOT MIGRATE ═════════════════════════════════════════════════════════
#
# These appear in a Vercel-pulled env file but must NOT be carried to a new host.
#
# Injected by the Vercel platform, meaningless elsewhere, and copying them makes
# the app believe it is still running on Vercel:
#   VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_REGION, VERCEL_TARGET_ENV,
#   VERCEL_OIDC_TOKEN, VERCEL_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_REF,
#   VERCEL_GIT_COMMIT_MESSAGE, VERCEL_GIT_COMMIT_AUTHOR_NAME,
#   VERCEL_GIT_COMMIT_AUTHOR_LOGIN, VERCEL_GIT_PREVIOUS_SHA,
#   VERCEL_GIT_PROVIDER, VERCEL_GIT_PULL_REQUEST_ID, VERCEL_GIT_REPO_ID,
#   VERCEL_GIT_REPO_OWNER, VERCEL_GIT_REPO_SLUG
#   (verified: zero reads of any VERCEL_* name anywhere in app/, lib/ or components/)
#
# Local build tooling, not runtime configuration:
#   TURBO_CACHE, TURBO_REMOTE_ONLY, TURBO_RUN_SUMMARY,
#   TURBO_DOWNLOAD_LOCAL_ENABLED, NX_DAEMON
#
# Declared somewhere but never read by any code path:
#   BROWSER_MEDIA_URL_MODE  (the code reads BROWSER_CDN_BASE_URL instead)
#   REAP_WEBHOOK_SECRET
#   NEXT_PUBLIC_CLERK_SIGN_IN_URL and the SIGN_UP / FORCE_REDIRECT /
#     FALLBACK_REDIRECT family — the Clerk SDK reads these itself, so keep them
#     only if your Clerk instance relies on them; nothing in this repo does.
#
# Inactive provider. lib/provider-registry.ts marks ElevenLabs
# "Disabled / Inactive provider. Not used by Saad Studio runtime" with
# allowRouting and allowFallback both false. The elevenlabs/* strings in the UI
# are model ids routed through other providers, not direct API calls:
#   ELEVENLABS_API_KEY, ELEVEN_LABS_API_KEY
#
# Legacy read-only storage, intentionally left alone:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Admin dashboard display only — these are hand-entered balance figures, not
# credentials, and are read dynamically via balanceEnvKeys in
# lib/provider-registry.ts. Safe to skip:
#   *_BALANCE_USD, *_USAGE_USD, *_COST_USD, *_CREDIT_USD, *_CREDITS,
#   BACKBLAZE_B2_CAP*_USD, BACKBLAZE_B2_BUDGET_USD, BACKBLAZE_B2_REMAINING_USD,
#   GOOGLE_BILLING_REPORT_URL, OPENAI_BILLING_URL, ELEVENLABS_BILLING_URL,
#   WAVESPEED_TOP_UP_URL, BACKBLAZE_B2_CAPS_URL
#
# Development only:
#   DEV_PANEL_USER_ID
#   NODE_ENV           (set by the runtime; the Dockerfile sets it to production)
#   NEXT_OUTPUT_MODE   (build-time only; the Dockerfile sets it)
#
# Cloudflare R2 as a WRITE target is not configured in production today: the
# R2_* credentials are present but EMPTY in the current .env.production. Leave
# them empty unless you intend to switch provider — and read the R2 warning in
# the migration notes first.
