CREDIT_MARGIN_PERCENT=
AUDIO_CREDIT_MARGIN_PERCENT=
WELCOME_SIGNUP_CREDITS=
SCENE_STUDIO_CREDITS=
CODE_CHAT_CREDITS=
ASSIST_CHAT_CREDITS=

# ── Provider billing dashboards (admin display only) ──────────────────────────
GOOGLE_BILLING_REPORT_URL=
GOOGLE_BILLING_USAGE_USD=
GOOGLE_BILLING_BALANCE_USD=
OPENAI_BILLING_URL=
ELEVENLABS_BILLING_URL=

# ── Moderation / safety ───────────────────────────────────────────────────────
NSFW_SCAN_ENABLED=
NSFW_SCAN_PROVIDER=
NSFW_SCAN_OPENAI_API_KEY=
NSFW_SCAN_OPENAI_MODEL=
NSFW_SCAN_INCLUDE_IMAGE_URLS=
STORYBOARD_NSFW_MODEL=
STORYBOARD_NSFW_SEXUAL_THRESHOLD=
STORYBOARD_VISION_NSFW_CHECK=
STORYBOARD_VISION_NSFW_MODEL=
STORYBOARD_SAFETY_TOKEN_SECRET=
GENERATION_PRECHECK_ENABLED=
GENERATION_PRECHECK_OPENAI_MODEL=
GENERATION_PRECHECK_OPENAI_BLOCKING=
PROMPT_EXTRACTOR_MODEL=

# ── Premiere / After Effects CEP panel ────────────────────────────────────────
PANEL_TOKEN_SECRET=
PANEL_TOKEN_MAX_AGE_SECONDS=
DEV_PANEL_USER_ID=
CALLBACK_SECRET=

# ── Admin access ──────────────────────────────────────────────────────────────
ADMIN_USER_ID=
ADMIN_EMAILS=

# ── Idempotency tuning ────────────────────────────────────────────────────────
IDEMPOTENCY_PROCESSING_LEASE_MS=
IDEMPOTENCY_HEARTBEAT_MS=
IDEMPOTENCY_FINAL_RETENTION_MS=

# ── Misc ──────────────────────────────────────────────────────────────────────
SAAD_WATERMARK_ENABLED=
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=
NEXTAUTH_SECRET=

# ── Self-hosting only ─────────────────────────────────────────────────────────
# Set by the Dockerfile to /usr/bin/ffmpeg. Override only to pin a different
# binary; lib/server/ffmpeg-path.ts discovers one from PATH when unset.
FFMPEG_PATH=
# Set to "standalone" at build time so next.config.mjs emits .next/standalone.
# The Dockerfile already does this; it is not needed at runtime.
NEXT_OUTPUT_MODE=
# Public base URL of the bucket holding the installers, e.g.
# https://f003.backblazeb2.com/file/saadstudio-storage
# When set, next.config.mjs redirects /downloads/* there instead of serving the
# ~103 MB in public/downloads from this host. Leave empty to serve locally.
# Upload with deploy/upload-static-to-b2.sh first.
STATIC_CDN_BASE_URL=
