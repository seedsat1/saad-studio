# Saad Studio environment template.
#
# This file is committed and must never contain a real value. Copy it on the
# server and fill in the copy:
#
#   cp .env.example .env.production
#   chmod 600 .env.production
#   chown root:root .env.production
#
# docker-compose.yml reads .env.production through `env_file`, so values reach
# the container as process env and are never baked into an image layer
# (.dockerignore excludes .env*). Rotate a value by editing the file and running
# `docker compose up -d --force-recreate app` — no rebuild needed, except for
# NEXT_PUBLIC_* below.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time, so
# changing one requires a rebuild and they must also be passed as build args.
# They are public by definition: never put a secret in a NEXT_PUBLIC_ name.
#
# The list below is generated from the 127 `process.env.*` reads in app/, lib/
# and components/, plus the two Prisma datasource variables. Anything marked
# REQUIRED is checked by GET /api/health.

# ── Core: required ────────────────────────────────────────────────────────────
# REQUIRED. Pooled PostgreSQL connection string (Neon).
DATABASE_URL=
# REQUIRED for `prisma migrate` / `prisma db push`. Direct, unpooled connection.
DIRECT_URL=

# REQUIRED. Clerk authentication.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# ── Site identity ─────────────────────────────────────────────────────────────
# Public origin, no trailing slash, e.g. https://saadstudio.app
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_URL=
APP_URL=
SITE_URL=
# Comma-separated origins allowed by CORS in lib/security.ts. Defaults to the
# saadstudio.app pair plus localhost when unset.
ALLOWED_ORIGINS=

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# REQUIRED for the six /api/cron/* endpoints; they return 503 without it.
# At least 16 characters. Generate with: openssl rand -hex 32
# On Vercel, setting this makes the platform send it as a Bearer token
# automatically. Off Vercel, see deploy/crontab.example.
CRON_SECRET=

# ── Storage: Backblaze B2 (active) ────────────────────────────────────────────
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=
B2_BUCKET_NAME=
B2_ENDPOINT=
B2_REGION=
B2_PUBLIC_URL=
B2_PUBLIC_BASE_URL=
NEXT_PUBLIC_B2_PUBLIC_URL=
NEXT_PUBLIC_B2_PUBLIC_BASE_URL=
BACKBLAZE_B2_CAPS_URL=

# ── Storage: Cloudflare R2 ────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# ── Storage: Supabase (legacy, read-only) ─────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Storage routing ───────────────────────────────────────────────────────────
MEDIA_PROVIDER=
MEDIA_FALLBACK_PROVIDER=
MEDIA_DELIVERY_MODE=
BROWSER_CDN_BASE_URL=
NEXT_PUBLIC_BROWSER_CDN_BASE_URL=

# ── Model providers ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
WAVESPEED_API_KEY=
WAVESPEED_TOP_UP_URL=
KIE_API_KEY=
KIEAI_API_KEY=
KIE_SYNC_CRON_TOKEN=
KIE_VIDEO_MODEL_OVERRIDES_JSON=
KIE_VIDEO_ROUTE_OVERRIDES_JSON=
KIE_IMAGE_MODEL_OVERRIDES_JSON=
XAI_API_KEY=
GROK_API_KEY=
GROQ_API_KEY=
REAP_API_KEY=
REAP_API_BASE=
RUNNINGHUB_API_KEY=
RUNNINGHUB_WORKFLOW_ID=
RUNNINGHUB_TEXT_NODE_ID=
RUNNINGHUB_IMAGE_NODE_ID=
AI_PROVIDER=

# ── BytePlus / Ark ────────────────────────────────────────────────────────────
BYTEPLUS_API_KEY=
BYTEPLUS_ARK_API_KEY=
ARK_API_KEY=
BYTEPLUS_BASE_URL=
BYTEPLUS_ARK_BASE_URL=
BYTEPLUS_ARK_USAGE_URL=
BYTEPLUS_MODEL=
BYTEPLUS_MODEL_FAST=
BYTEPLUS_MODEL_MINI=
BYTEPLUS_CDN_BASE_URL=
BYTEPLUS_MEDIA_CDN_BASE_URL=
BYTEPLUS_MEDIA_URL_MODE=
BYTEPLUS_IMAGE_PREPROCESS_MODE=

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
ZAINCASH_MERCHANT_ID=
ZAINCASH_MSISDN=
ZAINCASH_SECRET=
ZAINCASH_CLIENT_ID=
ZAINCASH_CLIENT_SECRET=
ZAINCASH_API_BASE_URL=
ZAINCASH_PAY_BASE_URL=
ZAINCASH_IQD_PER_USD=

# ── Email ─────────────────────────────────────────────────────────────────────
