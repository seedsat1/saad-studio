# ─────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES — Saad Studio
# Copy to .env (Railway) or paste into Vercel Dashboard
# NEVER commit the real .env to git
# ─────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://saadstudio.app
# Set NEXT_OUTPUT_MODE=standalone only when deploying via Docker (Railway)
# Leave empty for Vercel deployment
NEXT_OUTPUT_MODE=

# ─── Clerk Auth ───────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
# Use pk_live_ / sk_live_ for production
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/explore
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/explore
# Get from: Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_replace_me

# ─── Cloudflare R2 (Storage ONLY — images, videos, outputs) ──
# Create an R2 API token with Object Read/Write permissions.
# `R2_PUBLIC_BASE_URL` should be your public bucket/custom-domain base URL.
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=saadstudio-media
R2_PUBLIC_BASE_URL=https://media.example.com
# Optional overrides
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://media.example.com

# ─── Database (PostgreSQL via Prisma) ─────────────────────────
# Use any PostgreSQL provider. `DATABASE_URL` is used at runtime,
# and `DIRECT_URL` is used by Prisma migrations / db push.
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB_NAME?sslmode=require
DIRECT_URL=postgresql://USER:PASS@HOST:5432/DB_NAME?sslmode=require

# ─── AI Generation Providers ──────────────────────────────────
OPENAI_API_KEY=sk-replace_me
KIE_API_KEY=replace_me
KIEAI_API_KEY=replace_me
WAVESPEED_API_KEY=replace_me

# ─── Google AI (Gemini & Veo) ──────────────────────────────────
# Get from: https://aistudio.google.com/apikey
# Powers /cinematic-video — Veo 3.1 (text-to-video, image-to-video,
# first/last frame, reference images, video extension, native audio).
GOOGLE_AI_API_KEY=replace_me
PIAPI_API_KEY=replace_me
RUNNINGHUB_API_KEY=replace_me

# ─── Stripe ───────────────────────────────────────────────────
STRIPE_API_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ─── Security ─────────────────────────────────────────────────
# Optional: protect /api/callback against forged provider callbacks.
# If set, callbacks must include header: x-callback-secret
CALLBACK_SECRET=replace_me_callback_secret
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://saadstudio.app,https://www.saadstudio.app
